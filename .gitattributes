# =====================================================
# .gitattributes for project repos (hardware + software)
# Enforce LF endings and set up Git LFS for binary EDA assets
# =====================================================

# --- Default: treat text as LF on all platforms ---
* text=auto eol=lf

# --- Text files (explicit) ---
*.md        text eol=lf
*.txt       text eol=lf
*.csv       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.ini       text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.py        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
*.cpp       text eol=lf
*.hpp       text eol=lf
*.s         text eol=lf
*.S         text eol=lf
*.ld        text eol=lf
Makefile    text eol=lf

# --- Altium text-based config/project files ---
*.PrjPcb    text eol=lf
*.OutJob    text eol=lf
*.BomDoc    text eol=lf
*.DbLib     text eol=lf
*.SVNDbLib  text eol=lf

# =====================================================
# Git LFS for binary design assets (lockable)
# =====================================================
# Altium binaries
*.SchDoc  filter=lfs diff=lfs merge=lfs -text lockable
*.PcbDoc  filter=lfs diff=lfs merge=lfs -text lockable
*.SchLib  filter=lfs diff=lfs merge=lfs -text lockable
*.PcbLib  filter=lfs diff=lfs merge=lfs -text lockable
*.IntLib  filter=lfs diff=lfs merge=lfs -text lockable
*.PCBDwf  filter=lfs diff=lfs merge=lfs -text lockable

# Previews (binary)
*.PcbDocPreview filter=lfs diff=lfs merge=lfs -text
*.SchDocPreview filter=lfs diff=lfs merge=lfs -text

# 3D models
*.STEP   filter=lfs diff=lfs merge=lfs -text lockable
*.STP    filter=lfs diff=lfs merge=lfs -text lockable
*.x_t    filter=lfs diff=lfs merge=lfs -text lockable
*.x_b    filter=lfs diff=lfs merge=lfs -text lockable
*.iges   filter=lfs diff=lfs merge=lfs -text lockable
*.igs    filter=lfs diff=lfs merge=lfs -text lockable

# Documentation binaries
*.pdf    filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text

# =====================================================
# Hints:
# - Run `git lfs install` once after cloning.
# - Use `git lfs lock <file>` before editing binary EDA files.
# - After adding this file, normalize line endings:
#     git add --renormalize .
#     git commit -m "Normalize line endings to LF"
# =====================================================
